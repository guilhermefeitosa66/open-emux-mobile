<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: see backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="cheevos.xml" />
        <exclude domain="file" path="launch" />
        <exclude domain="file" path="share" />
        <exclude domain="file" path=".restore-staging" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cheevos.xml" />
        <exclude domain="file" path="launch" />
        <exclude domain="file" path="share" />
        <exclude domain="file" path=".restore-staging" />
    </device-transfer>
</data-extraction-rules>
