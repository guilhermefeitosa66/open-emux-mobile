    <!-- BIOS -->
    <string name="settings_bios_intro">சில கன்சோல்கள் அசல் சிஸ்டம் கோப்புடன் மட்டுமே தொடங்கும். உங்கள் சொந்தச் சாதனத்திலிருந்து நீங்கள் எடுத்தவற்றைப் பயன்படுத்துங்கள்.</string>
    <string name="settings_bios_checking">கோப்புகள் சரிபார்க்கப்படுகின்றன...</string>
    <string name="settings_bios_import_from_device">சாதனத்திலிருந்து இறக்குமதி செய்</string>
    <string name="settings_bios_pick_help">கோப்புகள் உள்ள கோப்புறையைத் தேர்ந்தெடுங்கள் (Downloads, SD கார்டு...). OpenEmux ஒவ்வொன்றையும் பெயரால், அல்லது தெரிந்தால் ஹாஷால் அடையாளம் கண்டு, சிஸ்டம் கோப்புறையில் நிறுவும்.</string>
    <plurals name="settings_bios_imported">
        <item quantity="one">%d கோப்பு அடையாளம் காணப்பட்டு நிறுவப்பட்டது.</item>
        <item quantity="other">%d கோப்புகள் அடையாளம் காணப்பட்டு நிறுவப்பட்டன.</item>
    </plurals>
    <plurals name="settings_bios_skipped">
        <item quantity="one">%d தவிர்க்கப்பட்டது.</item>
        <item quantity="other">%d தவிர்க்கப்பட்டன.</item>
    </plurals>
    <plurals name="settings_bios_none_found">
        <item quantity="one">அந்தக் கோப்புறையில் அறியப்பட்ட BIOS இல்லை. %d கோப்பு சரிபார்க்கப்பட்டது.</item>
        <item quantity="other">அந்தக் கோப்புறையில் அறியப்பட்ட BIOS இல்லை. %d கோப்புகள் சரிபார்க்கப்பட்டன.</item>
    </plurals>
