    <!-- First-run setup -->
    <string name="settings_setup_start">தொடங்கு</string>
    <string name="settings_setup_retry">மீண்டும் முயல்</string>
    <string name="settings_setup_title">OpenEmux தயாராகிறது</string>
    <string name="settings_setup_intro">முதல் முறை, ஆப் எமுலேட்டர்களையும் அவை பயன்படுத்தும் கோப்புகளையும் பதிவிறக்கும், சாதனத்தில் சுமார் 160 MB. இது இயங்கும்போது இணையம் தேவை; Wi-Fi சிறந்தது. அதன் பிறகு, அனைத்தும் இணையமின்றி இயங்கும்.</string>
    <string name="settings_setup_percent">%1$d%%</string>
    <string name="settings_setup_downloading">%1$s பதிவிறக்கப்படுகிறது</string>
    <string name="settings_setup_dont_close">முடியும் வரை ஆப்பை மூட வேண்டாம்.</string>
    <string name="settings_setup_resume_note">ஏற்கனவே பதிவிறக்கியவை வைக்கப்படும்; மீண்டும் முயன்றால் நின்ற இடத்திலிருந்து தொடரும்.</string>
    <string name="settings_setup_source">கோப்புகள் அதிகாரப்பூர்வ libretro buildbot இலிருந்து வருகின்றன.</string>
