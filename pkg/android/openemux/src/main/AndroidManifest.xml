<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:glEsVersion="0x00020000" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name="com.openemux.mobile.OpenEmuxApp"
        android:allowNativeHeapPointerTagging="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:appCategory="game"
        android:theme="@style/Theme.OpenEmux"
        android:enableOnBackInvokedCallback="true"
        tools:ignore="UnusedAttribute">

        <activity
            android:name="com.openemux.mobile.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The RetroArch engine in a process of its own: it exits the process
             when the content closes, and the library must survive that. -->
        <activity
            android:name="com.openemux.mobile.game.GameActivity"
            android:process=":game"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.openemux.mobile.game"
            android:excludeFromRecents="true"
            android:screenOrientation="fullUser"
            android:theme="@style/Theme.OpenEmux.Game"
            android:enableOnBackInvokedCallback="false"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|fontScale">
            <meta-data android:name="android.app.lib_name" android:value="retroarch-activity" />
            <meta-data android:name="android.app.func_name" android:value="ANativeActivity_onCreate" />
        </activity>
    </application>
</manifest>
